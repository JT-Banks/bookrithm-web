# Environment Variables for Bookrithm Frontend
# Copy this file to .env.local and fill in your values

# Backend API URL
# This is where your Java Spring Boot backend is running
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/bookrithm/v1

# Google OAuth Client ID
# You'll get this from Google Cloud Console when setting up OAuth
# https://console.cloud.google.com/apis/credentials
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
